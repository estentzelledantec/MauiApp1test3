<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:vues="clr-namespace:AutoMasters.Vues"
       x:Class="AutoMasters.AppShell"
       Shell.NavBarIsVisible="False">

    <Shell.Resources>
        <ResourceDictionary>
            <Style TargetType="TabBar">
                <Setter Property="Shell.TabBarBackgroundColor" Value="#121212" />
                <Setter Property="Shell.TabBarTitleColor" Value="#888888" />
                <Setter Property="Shell.TabBarUnselectedColor" Value="#888888" />
            </Style>
            <Style TargetType="ShellItem">
                <Setter Property="Shell.TabBarForegroundColor" Value="#ef4444" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <!-- ÉCRAN DE CONNEXION -->
    <ShellItem Route="Login">
        <ShellContent ContentTemplate="{DataTemplate vues:ConnexionPage}" />
    </ShellItem>

    <!-- MENU PRINCIPAL -->
    <TabBar Route="MainApp">
        <ShellContent Title="ACCUEIL" Route="AccueilPage" ContentTemplate="{DataTemplate vues:AccueilPage}" Icon="icon_home.png" />
        <ShellContent Title="COLLECTION" Route="CollectionPage" ContentTemplate="{DataTemplate vues:CollectionPage}" Icon="icon_garage.png" />
        <ShellContent Title="MARCHÉ" Route="MarchePage" ContentTemplate="{DataTemplate vues:MarchePage}" Icon="icon_marche.png" />
        <ShellContent Title="ORDRES" Route="OrdresPage" ContentTemplate="{DataTemplate vues:OrdresPage}" Icon="icon_ordres.png" />
        <ShellContent Title="CATALOGUE" Route="CataloguePage" ContentTemplate="{DataTemplate vues:CataloguePage}" Icon="icon_catalogue.png" />
    </TabBar>

</Shell>