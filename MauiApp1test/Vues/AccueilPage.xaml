<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoMasters.Vues.AccueilPage"
             BackgroundColor="#121212"
             Title="Accueil">

    <VerticalStackLayout VerticalOptions="Center" Spacing="15" Padding="30">

        <!-- Titre avec effet de fond -->
        <Border BackgroundColor="#1a1a1a" StrokeThickness="0" Padding="20,12" HorizontalOptions="Center" Margin="0,0,0,15">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Label>
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="BOOSTER " TextColor="White" FontSize="26" FontAttributes="Bold" />
                        <Span Text="AUTOMASTERS" TextColor="#ef4444" FontSize="26" FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </Border>

        <!-- Les 10 points de disponibilité -->
        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding PointsStock}" HorizontalOptions="Center" Spacing="8">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Ellipse WidthRequest="10" HeightRequest="10">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding .}" Value="True">
                                <Setter Property="Fill" Value="#ef4444" />
                            </DataTrigger>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding .}" Value="False">
                                <Setter Property="Fill" Value="#333333" />
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>

        <Label Text="{Binding TexteDisponibilite}" TextColor="#cccccc" FontSize="14" HorizontalOptions="Center" Margin="0,0,0,5" />

        <!-- Chronomètre jaune -->
        <Label Text="{Binding TempsRestant}" TextColor="#eab308" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" IsVisible="{Binding AfficheTimer}" Margin="0,-10,0,10" />

        <!-- Carte centrale avec halo -->
        <Grid HorizontalOptions="Center" HeightRequest="220" WidthRequest="160" Margin="0,15,0,25">
            <BoxView Color="#ef4444" Opacity="0.15" CornerRadius="16" Scale="1.1" />
            <Border BackgroundColor="#161616" Stroke="#ef4444" StrokeThickness="1" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout VerticalOptions="Center" Spacing="15">
                    <Label Text="🏎️" FontSize="45" HorizontalOptions="Center" />
                    <Label Text="AUTOMASTERS" TextColor="#ef4444" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Bouton Ouvrir -->
        <Button Text="⚡ OUVRIR" 
                Command="{Binding OuvrirBoosterCommand}" 
                IsEnabled="{Binding PeutOuvrir}"
                BackgroundColor="#ef4444" 
                TextColor="White" 
                HeightRequest="60" 
                CornerRadius="12" 
                FontAttributes="Bold" 
                FontSize="18" />

    </VerticalStackLayout>
</ContentPage>