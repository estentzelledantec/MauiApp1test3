<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="AutoMasters.Vues.CataloguePage">
<VerticalStackLayout Padding="14" Spacing="10">
<SearchBar Placeholder="Rechercher une marque, un modèle..." Text="{Binding Recherche}" SearchCommand="{Binding ChargerCommand}"/>
<CollectionView ItemsSource="{Binding Vehicules}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate>
<Border Margin="0,6" Padding="10" BackgroundColor="{StaticResource CardColor}" StrokeThickness="0"><Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto">
<Image Grid.RowSpan="3" Source="{Binding ImageUrl}" Aspect="AspectFill" HeightRequest="105" WidthRequest="100"/>
<Label Grid.Column="1" Text="{Binding Marque}" FontSize="13" TextColor="{StaticResource MutedColor}"/>
<Label Grid.Row="1" Grid.Column="1" Text="{Binding Modele}" FontSize="21" FontAttributes="Bold"/>
<Label Grid.Row="2" Grid.Column="1" Text="{Binding Prix, StringFormat='{}{0:N0} €'}" FontSize="16"/>
</Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
</VerticalStackLayout></ContentPage>